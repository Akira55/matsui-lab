---
import type { Locale } from '../data/site';
import { news, type NewsItem } from '../data/news';

interface Props {
  locale: Locale;
  limit?: number;
}
const { locale, limit } = Astro.props;
const items = limit ? news.slice(0, limit) : news;

const tagStyle: Record<NonNullable<NewsItem['tag']>, { bg: string; label: Record<Locale, string> }> = {
  paper: { bg: 'bg-pop-blue text-white', label: { en: 'PAPER', ja: '論文' } },
  talk: { bg: 'bg-pop-cyan text-pop-ink', label: { en: 'TALK', ja: '講演' } },
  award: { bg: 'bg-pop-yellow text-pop-ink', label: { en: 'AWARD', ja: '受賞' } },
  grant: { bg: 'bg-pop-purple text-white', label: { en: 'GRANT', ja: '助成' } },
  book: { bg: 'bg-pop-ink text-pop-paper', label: { en: 'BOOK', ja: '書籍' } },
  media: { bg: 'bg-pop-blue-soft text-pop-ink', label: { en: 'MEDIA', ja: 'メディア' } },
  lab: { bg: 'bg-pop-cyan-soft text-pop-ink', label: { en: 'LAB', ja: 'ラボ' } },
};
---

<ul class="grid gap-4">
  {items.map((item) => {
    const t = item.tag && tagStyle[item.tag];
    return (
      <li class="sticker-sm flex flex-col gap-2 p-4 transition-transform hover:-translate-y-0.5 sm:flex-row sm:items-start sm:gap-4">
        <div class="flex shrink-0 items-center gap-2">
          <time class="font-display text-sm tabular-nums text-pop-ink/70" datetime={item.date}>
            {item.date}
          </time>
          {t && (
            <span class:list={['rounded-full border-2 border-pop-ink px-2 py-0.5 font-display text-[10px] tracking-wide', t.bg]}>
              {t.label[locale]}
            </span>
          )}
        </div>
        <div>
          <p class="font-display text-base leading-snug text-pop-ink">
            {item.url ? (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:underline decoration-pop-yellow decoration-2 underline-offset-4"
              >
                {item.title[locale]} <span class="text-pop-blue" aria-hidden="true">↗</span>
              </a>
            ) : (
              item.title[locale]
            )}
          </p>
          {item.body && <p class="mt-1 text-sm text-pop-ink/70">{item.body[locale]}</p>}
        </div>
      </li>
    );
  })}
</ul>

---
import Layout from '../layouts/Layout.astro';
import FeedList from '../components/FeedList.astro';
import { getFeed } from '../data/feed';

const count = getFeed('en').length;
---

<Layout locale="en" current="news" title="News">
  <section class="container-page section">
    <p class="heading-eyebrow">News</p>
    <h1 class="heading-display mt-4">
      All <span class="bg-pop-blue text-white px-2 -rotate-1 inline-block border-[3px] border-pop-ink rounded-xl shadow-sticker">updates</span>
    </h1>
    <p class="mt-6 max-w-2xl text-pop-ink/80">
      Combined feed of papers, talks, columns, preprints, awards, grants, and lab news — newest first ({count} items).
    </p>

    <div class="mt-10">
      <FeedList locale="en" />
    </div>
  </section>
</Layout>

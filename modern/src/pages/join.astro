---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout locale="en" current="join" title="Join Us">
  <section class="container-page section">
    <p class="heading-eyebrow">Join Us</p>
    <h1 class="heading-display mt-4">
      <span class="bg-pop-cyan text-pop-ink px-2 -rotate-1 inline-block border-[3px] border-pop-ink rounded-xl shadow-sticker">Work</span>
      with us 🤝
    </h1>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <article class="sticker bg-white p-7">
        <h2 class="font-display text-2xl">Prospective students</h2>
        <p class="mt-3 text-pop-ink/80">
          Matsui Lab welcomes graduate students interested in computational social
          science, web information studies, and related areas. Backgrounds in
          statistics, machine learning, economics, or sociology are all welcome.
        </p>
        <p class="mt-3 text-pop-ink/80">
          Please email a brief introduction (CV, research interests, prior work)
          before applying through the official Kobe University graduate program.
        </p>
        <h3 class="mt-6 font-display text-lg">Postdocs & visiting researchers</h3>
        <p class="mt-2 text-sm text-pop-ink/80">
          We periodically host postdocs and visitors whose interests overlap with ours.
        </p>
        <h3 class="mt-6 font-display text-lg">Undergraduates</h3>
        <p class="mt-2 text-sm text-pop-ink/80">
          Limited research assistant positions are available each semester for
          motivated undergrads with programming experience.
        </p>
      </article>

      <aside class="sticker bg-pop-yellow-soft p-7">
        <h3 class="font-display text-xl">How to apply</h3>
        <ol class="mt-4 list-decimal space-y-3 pl-5 text-pop-ink/80">
          <li>Submit the <a class="link" href={site.contactForm}>contact form</a> with your CV and a short statement of interest.</li>
          <li>We will follow up to discuss fit and next steps.</li>
          <li>Apply through Kobe University's graduate admissions.</li>
        </ol>
        <a
          href={site.contactForm}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pop mt-5"
        >
          Open contact form ↗
        </a>
      </aside>
    </div>
  </section>
</Layout>

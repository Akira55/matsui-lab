---
import Layout from '../../layouts/Layout.astro';
import MiscList from '../../components/MiscList.astro';
import { site } from '../../data/site';
import { misc } from '../../data/misc';
---

<Layout
  locale="ja"
  current="publications"
  title="MISC"
  description="コラム・プレプリント・ワーキングペーパー・レポート"
>
  <section class="container-page section">
    <p class="heading-eyebrow">MISC</p>
    <h1 class="heading-display mt-4">
      コラム・<span class="bg-pop-purple text-white px-2 -rotate-1 inline-block border-[3px] border-pop-ink rounded-xl shadow-sticker">プレプリント</span>・WP
    </h1>
    <p class="mt-6 max-w-2xl text-pop-ink/80">
      経済セミナー連載、arXivプレプリント、ワーキングペーパー、参加報告など全{misc.length}件。完全な一覧は
      <a class="link" href={site.socials.researchmap}>researchmap</a>
      をご参照ください。
    </p>

    <div class="mt-12">
      <MiscList locale="ja" />
    </div>
  </section>
</Layout>

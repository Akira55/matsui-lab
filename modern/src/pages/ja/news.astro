---
import Layout from '../../layouts/Layout.astro';
import FeedList from '../../components/FeedList.astro';
import { getFeed } from '../../data/feed';

const count = getFeed('ja').length;
---

<Layout locale="ja" current="news" title="ニュース">
  <section class="container-page section">
    <p class="heading-eyebrow">News</p>
    <h1 class="heading-display mt-4">
      すべての<span class="bg-pop-blue text-white px-2 -rotate-1 inline-block border-[3px] border-pop-ink rounded-xl shadow-sticker">お知らせ</span>
    </h1>
    <p class="mt-6 max-w-2xl text-pop-ink/80">
      論文・講演・コラム・プレプリント・受賞・科研費・研究室のお知らせをまとめて新しい順に表示しています（全{count}件）。
    </p>

    <div class="mt-10">
      <FeedList locale="ja" />
    </div>
  </section>
</Layout>

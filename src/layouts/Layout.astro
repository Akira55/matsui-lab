---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../data/site';
import { site } from '../data/site';
import { ui } from '../data/i18n';
import { u } from '../lib/url';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  current?: string;
}

const { locale, title, description, current } = Astro.props;
const fullTitle = `${title} · ${site.labName[locale]}`;
const windowTitle = locale === 'ja' ? `松井研究室ディスク：${title}` : `Matsui Lab Disk: ${title}`;
const gaId = site.gaMeasurementId;
const enableGA = import.meta.env.PROD && !!gaId;
const homeHref = u(locale === 'ja' ? '/ja/' : '/');
const researchHref = u(locale === 'ja' ? '/ja/research/' : '/research/');
const papersHref = u(locale === 'ja' ? '/ja/publications/' : '/publications/');
const kidPixHref = locale === 'ja' ? 'https://kidpix.app/ja.html' : 'https://kidpix.app/';
const cvHref = site.socials.cv;
const cvPreviewHref = cvHref.replace(/\/view(?:\?.*)?$/, '/preview');
const cvFileId = cvHref.match(/\/d\/([^/]+)/)?.[1];
const cvDownloadHref = cvFileId ? `https://drive.google.com/uc?export=download&id=${cvFileId}` : cvHref;
const bootTitle = 'Welcome to MatLab';
const bootMessage = locale === 'ja' ? '起動ディスク “松井研究室 HD” を読み込んでいます…' : 'Loading startup disk “Matsui Lab HD”…';
const bootSkip = locale === 'ja' ? 'スキップ' : 'Skip';
const isMainPage = current === 'home';
const siteBasePath = u('/');
const bootCharacterSrc = u('/charactor-pixel.png');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#7d879f" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(u('/og.png'), Astro.site)} />
    <script is:inline define:vars={{ isMainPage, siteBasePath }}>
      try {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let cameFromThisSite = false;
        if (document.referrer) {
          const previousPage = new URL(document.referrer);
          cameFromThisSite = previousPage.origin === window.location.origin
            && previousPage.pathname.startsWith(siteBasePath);
        }
        if (!reduceMotion && isMainPage && !cameFromThisSite) {
          document.documentElement.classList.add('boot-required');
        }
      } catch (error) {
        /* Continue without the startup screen if the referrer cannot be read. */
      }
    </script>
    {enableGA && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <div class="boot-screen" data-boot-screen role="status" aria-live="polite">
      <div class="boot-dialog">
        <img class="boot-character" src={bootCharacterSrc} alt="" aria-hidden="true" />
        <strong>{bootTitle}</strong>
        <p data-boot-message>{bootMessage}</p>
        <div class="boot-progress" aria-hidden="true"><span></span></div>
        <button type="button" data-boot-skip>{bootSkip}</button>
      </div>
    </div>
    <a href="#main" class="sr-only focus:not-sr-only">{ui[locale].skipToContent}</a>
    <Header locale={locale} current={current} />
    <div class="mac-desktop">
      <button class="desktop-reopen" type="button" data-reopen-window aria-label={locale === 'ja' ? '松井研究室ディスクを開く' : 'Open Matsui Lab Disk'}>
        <span class="mac-icon hard-drive-icon" aria-hidden="true"></span>
        <span>{locale === 'ja' ? '松井研究室 HD' : 'Matsui Lab HD'}</span>
      </button>
      <aside class="desktop-icons" aria-label={locale === 'ja' ? 'デスクトップ' : 'Desktop'}>
        <a href={researchHref} class="desktop-icon"><span class="mac-icon disk-icon" aria-hidden="true"></span><span>{locale === 'ja' ? '研究フォルダ' : 'Research Folder'}</span></a>
        <a href={papersHref} class="desktop-icon"><span class="mac-icon folder-icon" aria-hidden="true"></span><span>{locale === 'ja' ? '論文フォルダ' : 'Papers Folder'}</span></a>
        <a href={cvHref} target="_blank" rel="noopener noreferrer" class="desktop-icon" data-cv-open><span class="mac-icon document-icon" aria-hidden="true"><span>CV</span></span><span>Akira's CV</span></a>
        <a href={kidPixHref} target="_blank" rel="noopener noreferrer" class="desktop-icon" data-kidpix-open><span class="mac-icon kidpix-icon" aria-hidden="true"><span></span></span><span>{locale === 'ja' ? 'キッドピクス' : 'Kid Pix'}</span></a>
      </aside>
      <div class="mac-window" data-mac-window>
        <div class="mac-titlebar" data-window-handle>
          <button class="close-box" type="button" data-close-window aria-label={locale === 'ja' ? 'ウィンドウを閉じる' : 'Close window'}></button>
          <span>{windowTitle}</span>
          <button class="zoom-box" type="button" data-zoom-window aria-label={locale === 'ja' ? 'ウィンドウを拡大・縮小する' : 'Zoom window'}></button>
        </div>
        <main id="main"><slot /></main>
        <Footer locale={locale} />
      </div>
    </div>
    <dialog class="kidpix-dialog" data-kidpix-dialog aria-labelledby="kidpix-window-title">
      <div class="kidpix-window">
        <div class="mac-titlebar kidpix-titlebar">
          <button class="close-box" type="button" data-kidpix-close aria-label={locale === 'ja' ? 'Kid Pixを閉じる' : 'Close Kid Pix'}></button>
          <span id="kidpix-window-title">Kid Pix — External Application</span>
          <span class="zoom-box" aria-hidden="true"></span>
        </div>
        <div class="kidpix-notice">
          <span>{locale === 'ja' ? '外部サイト kidpix.app を表示しています' : 'Displaying the external site kidpix.app'}</span>
          <a href={kidPixHref} target="_blank" rel="noopener noreferrer">{locale === 'ja' ? '元のサイトで開く ↗' : 'Open original site ↗'}</a>
        </div>
        <div class="kidpix-frame-shell">
          <p class="kidpix-loading" aria-hidden="true">{locale === 'ja' ? 'Kid Pixを読み込んでいます…' : 'Loading Kid Pix…'}</p>
          <iframe
            data-kidpix-frame
            data-src={kidPixHref}
            src="about:blank"
            title={locale === 'ja' ? '外部サイトのJS Kid Pix' : 'External JS Kid Pix application'}
            allow="autoplay; clipboard-write"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
        <div class="kidpix-statusbar">
          <span>JS Kid Pix by vikrum</span>
          <div>
            <a href="https://github.com/vikrum/kidpix" target="_blank" rel="noopener noreferrer">{locale === 'ja' ? '出典・ライセンス' : 'Source & license'}</a>
            <button type="button" class="mac-button" data-kidpix-close>{locale === 'ja' ? '閉じる' : 'Close'}</button>
          </div>
        </div>
      </div>
    </dialog>
    <dialog class="kidpix-dialog" data-cv-dialog aria-labelledby="cv-window-title">
      <div class="kidpix-window">
        <div class="mac-titlebar kidpix-titlebar">
          <button class="close-box" type="button" data-cv-close aria-label={locale === 'ja' ? 'CVを閉じる' : 'Close CV'}></button>
          <span id="cv-window-title">Akira's CV</span>
          <span class="zoom-box" aria-hidden="true"></span>
        </div>
        <div class="kidpix-notice">
          <span>{locale === 'ja' ? 'Google Drive上のPDFを表示しています' : 'Displaying a PDF from Google Drive'}</span>
          <div class="cv-notice-actions">
            <a href={cvDownloadHref} target="_blank" rel="noopener noreferrer" download="cv_akiramatsui.pdf" class="cv-download-button">{locale === 'ja' ? '↓ PDFをダウンロード' : '↓ Download PDF'}</a>
            <a href={cvHref} target="_blank" rel="noopener noreferrer">{locale === 'ja' ? '元のPDFを開く ↗' : 'Open original PDF ↗'}</a>
          </div>
        </div>
        <div class="kidpix-frame-shell">
          <p class="kidpix-loading" aria-hidden="true">{locale === 'ja' ? 'CVを読み込んでいます…' : 'Loading CV…'}</p>
          <iframe
            data-cv-frame
            data-src={cvPreviewHref}
            src="about:blank"
            title={locale === 'ja' ? '松井彰人のCV PDF' : "Akira Matsui's CV PDF"}
            allow="fullscreen"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
        <div class="kidpix-statusbar">
          <span>Akira Matsui · Curriculum Vitae</span>
          <div>
            <a href={cvHref} target="_blank" rel="noopener noreferrer">Google Drive ↗</a>
            <a href={cvDownloadHref} target="_blank" rel="noopener noreferrer" download="cv_akiramatsui.pdf" class="mac-button">{locale === 'ja' ? 'PDFをダウンロード' : 'Download PDF'}</a>
            <button type="button" class="mac-button" data-cv-close>{locale === 'ja' ? '閉じる' : 'Close'}</button>
          </div>
        </div>
      </div>
    </dialog>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const body = document.body;
        const boot = document.querySelector('[data-boot-screen]');
        const bootSkip = document.querySelector('[data-boot-skip]');
        const macWindow = document.querySelector('[data-mac-window]');
        const closeButton = document.querySelector('[data-close-window]');
        const reopenButton = document.querySelector('[data-reopen-window]');
        const zoomButton = document.querySelector('[data-zoom-window]');
        const handle = document.querySelector('[data-window-handle]');
        const kidPixDialog = document.querySelector('[data-kidpix-dialog]');
        const kidPixFrame = document.querySelector('[data-kidpix-frame]');
        let kidPixOpener = null;
        const cvDialog = document.querySelector('[data-cv-dialog]');
        const cvFrame = document.querySelector('[data-cv-frame]');
        let cvOpener = null;

        const finishBoot = () => {
          if (!root.classList.contains('boot-required')) return;
          root.classList.add('boot-finishing');
          window.setTimeout(() => {
            root.classList.remove('boot-required', 'boot-finishing');
          }, 320);
        };

        if (root.classList.contains('boot-required')) {
          const bootMessage = document.querySelector('[data-boot-message]');
          const messages = document.documentElement.lang === 'ja'
            ? ['システム機能拡張を読み込んでいます…', '松井研究室デスクトップを準備しています…']
            : ['Loading system extensions…', 'Preparing the Matsui Lab desktop…'];
          window.setTimeout(() => { if (bootMessage) bootMessage.textContent = messages[0]; }, 820);
          window.setTimeout(() => { if (bootMessage) bootMessage.textContent = messages[1]; }, 1650);
          window.setTimeout(finishBoot, 2700);
          bootSkip?.addEventListener('click', finishBoot);
        }

        closeButton?.addEventListener('click', () => {
          macWindow?.classList.add('is-closing');
          window.setTimeout(() => {
            body.classList.add('is-window-closed');
            macWindow?.classList.remove('is-closing');
            reopenButton?.focus();
          }, 210);
        });

        const reopenWindow = () => {
          body.classList.remove('is-window-closed');
          macWindow?.classList.add('is-reopening');
          window.setTimeout(() => macWindow?.classList.remove('is-reopening'), 260);
          closeButton?.focus();
        };
        reopenButton?.addEventListener('click', reopenWindow);
        reopenButton?.addEventListener('dblclick', reopenWindow);

        zoomButton?.addEventListener('click', () => {
          const expanded = body.classList.toggle('is-window-zoomed');
          zoomButton.setAttribute('aria-pressed', String(expanded));
          macWindow?.style.removeProperty('--drag-x');
          macWindow?.style.removeProperty('--drag-y');
        });

        let drag = null;
        handle?.addEventListener('pointerdown', (event) => {
          if (event.target.closest('button') || window.innerWidth < 900 || body.classList.contains('is-window-zoomed')) return;
          drag = { id: event.pointerId, startX: event.clientX, startY: event.clientY, x: 0, y: 0 };
          handle.setPointerCapture(event.pointerId);
          macWindow?.classList.add('is-dragging');
        });
        handle?.addEventListener('pointermove', (event) => {
          if (!drag || drag.id !== event.pointerId || !macWindow) return;
          drag.x = Math.max(-150, Math.min(150, event.clientX - drag.startX));
          drag.y = Math.max(-35, Math.min(90, event.clientY - drag.startY));
          macWindow.style.setProperty('--drag-x', `${drag.x}px`);
          macWindow.style.setProperty('--drag-y', `${drag.y}px`);
        });
        const stopDrag = (event) => {
          if (!drag || drag.id !== event.pointerId) return;
          drag = null;
          macWindow?.classList.remove('is-dragging');
        };
        handle?.addEventListener('pointerup', stopDrag);
        handle?.addEventListener('pointercancel', stopDrag);

        document.querySelectorAll('[data-kidpix-open]').forEach((link) => {
          link.addEventListener('click', (event) => {
            if (!kidPixDialog?.showModal || !kidPixFrame) return;
            event.preventDefault();
            kidPixOpener = link;
            if (kidPixFrame.getAttribute('src') === 'about:blank') {
              kidPixFrame.setAttribute('src', kidPixFrame.dataset.src);
            }
            kidPixDialog.showModal();
          });
        });

        document.querySelectorAll('[data-kidpix-close]').forEach((button) => {
          button.addEventListener('click', () => kidPixDialog?.close());
        });
        kidPixDialog?.addEventListener('click', (event) => {
          if (event.target === kidPixDialog) kidPixDialog.close();
        });
        kidPixDialog?.addEventListener('close', () => kidPixOpener?.focus());

        document.querySelectorAll('[data-cv-open]').forEach((link) => {
          link.addEventListener('click', (event) => {
            if (!cvDialog?.showModal || !cvFrame) return;
            event.preventDefault();
            cvOpener = link;
            if (cvFrame.getAttribute('src') === 'about:blank') {
              cvFrame.setAttribute('src', cvFrame.dataset.src);
            }
            cvDialog.showModal();
          });
        });

        document.querySelectorAll('[data-cv-close]').forEach((button) => {
          button.addEventListener('click', () => cvDialog?.close());
        });
        cvDialog?.addEventListener('click', (event) => {
          if (event.target === cvDialog) cvDialog.close();
        });
        cvDialog?.addEventListener('close', () => cvOpener?.focus());
      })();
    </script>
  </body>
</html>

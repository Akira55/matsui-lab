---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../data/site';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  current?: string;
}

const { locale, title, description, current } = Astro.props;
const fullTitle = `${title} · ${site.labName[locale]}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Hachi+Maru+Pop&family=Yusei+Magic&family=Reggae+One&family=Bungee&family=M+PLUS+Rounded+1c:wght@400;500;700;800&family=Kosugi+Maru&family=Quicksand:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!--
      Hide the intro animation on repeat visits.
      Runs synchronously before <body> renders so there is no flash.
      Bump the storage key (e.g. v1 → v2) to make the intro replay for everyone.
    -->
    <script is:inline>
      try {
        if (localStorage.getItem('matlab-intro-played-v1') === 'true') {
          document.documentElement.classList.add('no-intro');
        }
      } catch (e) {
        /* localStorage may be unavailable (private mode) — show intro by default */
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
    <Header locale={locale} current={current} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

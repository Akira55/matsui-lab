---
import Layout from '../../layouts/Layout.astro';
import TalksList from '../../components/TalksList.astro';
import Sparkle from '../../components/Sparkle.astro';
import { site } from '../../data/site';
import { talks } from '../../data/talks';

const invitedCount = talks.filter((t) => t.type === 'invited').length;
---

<Layout
  locale="ja"
  current="talks"
  title="講演"
  description="松井研究室の講演・口頭発表一覧"
>
  <section class="container-page section">
    <p class="heading-eyebrow">Talks</p>
    <h1 class="heading-display mt-4">
      <span class="bg-pop-cyan text-pop-ink px-2 -rotate-1 inline-block border-[3px] border-pop-ink rounded-xl shadow-sticker">講演</span>・口頭発表
      &nbsp;<Sparkle class="h-7 w-7 inline-block align-baseline" />
    </h1>
    <p class="mt-6 max-w-2xl text-pop-ink/80">
      国内外の招待講演・口頭発表（{talks.length}件、招待{invitedCount}件）。完全な一覧は
      <a class="link" href={site.socials.researchmap}>researchmap</a>
      をご参照ください。
    </p>

    <div class="mt-12">
      <TalksList locale="ja" />
    </div>
  </section>
</Layout>

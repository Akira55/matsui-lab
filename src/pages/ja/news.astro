---
import Layout from '../../layouts/Layout.astro';
import FeedList from '../../components/FeedList.astro';
import { getFeed } from '../../data/feed';

const count = getFeed('ja').length;
---

<Layout locale="ja" current="news" title="ニュース">
  <section class="container-page section">
    <p class="heading-eyebrow">最近使った項目</p>
    <h1 class="heading-display mt-4">
      新しく追加された<span class="bg-pop-blue text-white px-2 inline-block border-[3px] border-pop-ink">書類</span>
    </h1>
    <p class="mt-6 max-w-2xl text-pop-ink/80">
      松井研究室ディスクに追加された論文・講演・コラム・プレプリント・受賞・科研費などを、新しい順に表示しています（全{count}項目）。
    </p>

    <div class="mt-10">
      <FeedList locale="ja" />
    </div>
  </section>
</Layout>

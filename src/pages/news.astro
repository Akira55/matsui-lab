---
import Layout from '../layouts/Layout.astro';
import FeedList from '../components/FeedList.astro';
import { getFeed } from '../data/feed';

const count = getFeed('en').length;
---

<Layout locale="en" current="news" title="News">
  <section class="container-page section">
    <p class="heading-eyebrow">Recent Items</p>
    <h1 class="heading-display mt-4">
      Newly added <span class="bg-pop-blue text-white px-2 inline-block border-[3px] border-pop-ink">documents</span>
    </h1>
    <p class="mt-6 max-w-2xl text-pop-ink/80">
      Documents recently added to the Matsui Lab Disk—papers, talks, columns, preprints, awards, and grants—are shown newest first ({count} items).
    </p>

    <div class="mt-10">
      <FeedList locale="en" />
    </div>
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import TalksList from '../components/TalksList.astro';
import { site } from '../data/site';
import { talks } from '../data/talks';

const invitedCount = talks.filter((t) => t.type === 'invited').length;
---

<Layout
  locale="en"
  current="talks"
  title="Talks"
  description="Invited and contributed talks at Matsui Lab"
>
  <section class="container-page section">
    <p class="heading-eyebrow">Talks Folder</p>
    <h1 class="heading-display mt-4">
      Documents in the <span class="bg-pop-cyan text-pop-ink px-2 inline-block border-[3px] border-pop-ink">Talks Folder</span>
      <span class="mac-heading-glyph" aria-hidden="true">✦</span>
    </h1>
    <p class="mt-6 max-w-2xl text-pop-ink/80">
      This folder contains invited and contributed talks at international and domestic venues
      ({talks.length} entries, {invitedCount} invited). Full list maintained on
      <a class="link" href={site.socials.researchmap}>researchmap</a>.
    </p>

    <div class="mt-12">
      <TalksList locale="en" />
    </div>
  </section>
</Layout>

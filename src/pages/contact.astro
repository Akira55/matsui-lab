---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout locale="en" current="contact" title="Contact">
  <section class="container-page section">
    <p class="heading-eyebrow">Connection Settings</p>
    <h1 class="heading-display mt-4">
      <span class="bg-pop-blue text-white px-2 inline-block border-[3px] border-pop-ink">Contact Matsui Lab</span>
    </h1>
    <p class="mt-6 max-w-2xl text-pop-ink/80">
      For collaboration, students, talks, or media inquiries, choose “Open Contact Form…” below. We aim to reply within a few business days.
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <div class="sticker bg-pop-paper p-7">
        <dl class="space-y-5">
          <div>
            <dt class="font-display text-xs tracking-wider text-pop-blue">CONTACT</dt>
            <dd class="mt-2">
              <a
                href={site.contactForm}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-pop"
              >
                Open Contact Form…
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-display text-xs tracking-wider text-pop-blue">AFFILIATION</dt>
            <dd class="mt-1">{site.affiliation.en}</dd>
          </div>
          <div>
            <dt class="font-display text-xs tracking-wider text-pop-blue">ADDRESS</dt>
            <dd class="mt-1">2-1 Rokkodai-cho, Nada-ku, Kobe 657-8501, Japan</dd>
          </div>
          <div>
            <dt class="font-display text-xs tracking-wider text-pop-blue">PROFILES</dt>
            <dd class="mt-1 flex flex-wrap gap-2">
              <a class="chip bg-pop-cyan-soft hover:bg-pop-cyan" href={site.socials.researchmap}>researchmap ↗</a>
              <a class="chip bg-pop-yellow-soft hover:bg-pop-yellow" href={site.socials.kobe}>Kobe U ↗</a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="sticker overflow-hidden p-0">
        <iframe
          title="Kobe University on map"
          class="h-72 w-full"
          src="https://www.openstreetmap.org/export/embed.html?bbox=135.234%2C34.724%2C135.244%2C34.728&layer=mapnik&marker=34.726%2C135.239"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

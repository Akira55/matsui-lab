---
import type { Locale } from '../data/site';
import { u } from '../lib/url';

interface Props {
  locale: Locale;
  characterSrc: string;
}

const { locale, characterSrc } = Astro.props;
const bgmSrc = u('/audio/maou_loop_bgm_8bit17.m4a');
const starBgmSrc = u('/audio/maou_bgm_8bit25.m4a');
const copy = locale === 'ja'
  ? {
      open: 'キャラクターをクリックしてミニゲームを開く',
      hint: 'クリックして遊ぶ',
      title: '松井研究室ランナー',
      score: 'スコア',
      high: 'ベスト',
      ready: 'Space・↑・クリックでジャンプ',
      start: 'キーを押してスタート',
      over: 'ゲームオーバー',
      retry: 'もう一度',
      close: '終了',
      closeLabel: 'ゲームを閉じる',
      musicOn: '音楽 ON',
    }
  : {
      open: 'Click the character to open the mini game',
      hint: 'Click to play',
      title: 'Matsui Lab Runner',
      score: 'Score',
      high: 'Best',
      ready: 'Space, ↑, or click to jump',
      start: 'Press to start',
      over: 'Game Over',
      retry: 'Try Again',
      close: 'Quit',
      closeLabel: 'Close game',
      musicOn: 'Music ON',
    };
---

<button class="character-game-launcher" type="button" data-game-open aria-label={copy.open}>
  <img class="pixel-character" src={characterSrc} alt="" />
  <span>{copy.hint} <b aria-hidden="true">▶</b></span>
</button>

<dialog class="runner-dialog" data-runner-dialog data-runner-src={characterSrc} aria-labelledby="runner-title">
  <div class="runner-window">
    <div class="runner-titlebar">
      <button type="button" class="runner-close-box" data-game-close aria-label={copy.closeLabel}></button>
      <strong id="runner-title">{copy.title}</strong>
      <span class="runner-zoom-box" aria-hidden="true"></span>
    </div>
    <div class="runner-toolbar" aria-live="polite">
      <button type="button" class="runner-mute" data-game-mute aria-pressed="false" aria-label={locale === 'ja' ? '音楽をミュートする' : 'Mute music'}>
        <span aria-hidden="true" data-game-mute-icon>♪</span>
        <span data-game-mute-label>{copy.musicOn}</span>
      </button>
      <span>{copy.score}: <b data-game-score>00000</b></span>
      <span>{copy.high}: <b data-game-high>00000</b></span>
    </div>
    <canvas
      class="runner-canvas"
      data-runner-canvas
      width="720"
      height="260"
      tabindex="0"
      aria-label={`${copy.title}。${copy.ready}`}
    ></canvas>
    <div class="runner-controls">
      <span><kbd>SPACE</kbd> / <kbd>↑</kbd> / <span class="mouse-symbol" aria-hidden="true">▣</span> {copy.ready}</span>
      <div>
        <button type="button" class="mac-button runner-retry" data-game-retry>{copy.retry}</button>
        <button type="button" class="default-button" data-game-close>{copy.close}</button>
      </div>
    </div>
    <div class="runner-credit">
      <a href="https://maou.audio/bgm_8bit17/" target="_blank" rel="noopener noreferrer">BGM：魔王魂（森田交一）</a>
      <span>Runner: <a href="https://maou.audio/bgm_8bit17/" target="_blank" rel="noopener noreferrer">8bit17</a> · Star: <a href="https://maou.audio/bgm_8bit25/" target="_blank" rel="noopener noreferrer">8bit25</a></span>
    </div>
  </div>
  <audio data-game-bgm data-runner-src={bgmSrc} data-star-src={starBgmSrc} src={bgmSrc} preload="none" loop></audio>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-runner-dialog]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-game-open]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-runner-canvas]');

  if (dialog && openButton && canvas) {
    const context = canvas.getContext('2d');
    const scoreOutput = dialog.querySelector<HTMLElement>('[data-game-score]');
    const highOutput = dialog.querySelector<HTMLElement>('[data-game-high]');
    const retryButton = dialog.querySelector<HTMLButtonElement>('[data-game-retry]');
    const muteButton = dialog.querySelector<HTMLButtonElement>('[data-game-mute]');
    const muteIcon = dialog.querySelector<HTMLElement>('[data-game-mute-icon]');
    const muteLabel = dialog.querySelector<HTMLElement>('[data-game-mute-label]');
    const bgm = dialog.querySelector<HTMLAudioElement>('[data-game-bgm]');
    const closeButtons = dialog.querySelectorAll<HTMLButtonElement>('[data-game-close]');
    const locale = document.documentElement.lang;
    const words = locale === 'ja'
      ? { ready: 'キーを押してスタート', over: 'ゲームオーバー', again: 'Space またはクリックでもう一度' }
      : { ready: 'Press to start', over: 'Game Over', again: 'Press Space or click to try again' };
    const runnerImage = new Image();
    runnerImage.src = dialog.dataset.runnerSrc || '';
    const width = canvas.width;
    const runnerHeight = canvas.height;
    const starHeight = 360;
    let height = runnerHeight;
    const ground = 207;
    const secretScore = 500;
    const runner = { x: 72, y: ground - 62, width: 48, height: 62, velocity: 0 };
    let obstacles: Array<{ x: number; width: number; height: number; kind: number }> = [];
    let starEnemies: Array<{ x: number; y: number; width: number; height: number; alive: boolean; diving: boolean; diveVx: number; divePhase: number }> = [];
    let playerShots: Array<{ x: number; y: number }> = [];
    let enemyShots: Array<{ x: number; y: number }> = [];
    const starShip = { x: width / 2 - 18, y: height - 38, width: 36, height: 23 };
    let frame = 0;
    let previous = 0;
    let spawnIn = 1000;
    let score = 0;
    let high = 0;
    let mode: 'ready' | 'playing' | 'over' | 'star' | 'star-over' = 'ready';
    let musicMuted = false;
    let starDirection = 1;
    let diveIn = 2200;
    let starBannerUntil = 0;
    let commandBuffer = '';
    let leftHeld = false;
    let rightHeld = false;

    try { high = Number(localStorage.getItem('matsui-lab-runner-high') || 0); } catch (_) {}
    try { musicMuted = localStorage.getItem('matsui-lab-runner-music-muted') === 'true'; } catch (_) {}

    const updateMusicButton = () => {
      if (bgm) bgm.muted = musicMuted;
      if (muteButton) {
        muteButton.setAttribute('aria-pressed', String(musicMuted));
        muteButton.setAttribute('aria-label', musicMuted
          ? (locale === 'ja' ? '音楽を再生する' : 'Turn music on')
          : (locale === 'ja' ? '音楽をミュートする' : 'Mute music'));
      }
      if (muteIcon) muteIcon.textContent = musicMuted ? '×' : '♪';
      if (muteLabel) muteLabel.textContent = musicMuted
        ? (locale === 'ja' ? '音楽 OFF' : 'Music OFF')
        : (locale === 'ja' ? '音楽 ON' : 'Music ON');
    };

    const playBgm = (source: string | undefined) => {
      if (!bgm || !source) return;
      if (bgm.getAttribute('src') !== source) {
        bgm.pause();
        bgm.setAttribute('src', source);
        bgm.load();
      }
      bgm.volume = .34;
      bgm.muted = musicMuted;
      bgm.play().catch(() => {});
    };

    // A shifted Gamma(k=3) interval feels less mechanical than a uniform roll:
    // short gaps are possible, long rests occasionally occur, and impossible
    // rapid-fire sequences are prevented by the reaction-time floor.
    const nextSpawnDelay = () => {
      const difficulty = Math.min(1, score / 420);
      const minimumGap = 760 - difficulty * 150;
      const scale = 170 - difficulty * 35;
      const product = Math.max(0.000001, Math.random() * Math.random() * Math.random());
      const gammaSample = -Math.log(product) * scale;
      return Math.min(2200, minimumGap + gammaSample);
    };

    const formatScore = (value: number) => String(Math.floor(value)).padStart(5, '0');
    const updateScores = () => {
      if (scoreOutput) scoreOutput.textContent = formatScore(score);
      if (highOutput) highOutput.textContent = formatScore(high);
    };

    const reset = () => {
      if (canvas.height !== runnerHeight) canvas.height = runnerHeight;
      height = runnerHeight;
      obstacles = [];
      starEnemies = [];
      playerShots = [];
      enemyShots = [];
      runner.y = ground - runner.height;
      runner.velocity = 0;
      score = 0;
      spawnIn = nextSpawnDelay();
      mode = 'ready';
      commandBuffer = '';
      leftHeld = false;
      rightHeld = false;
      previous = 0;
      updateScores();
      draw();
    };

    const startOrJump = () => {
      if (mode === 'star') {
        fireStarShot();
        return;
      }
      if (mode === 'star-over') {
        enterStarMode();
        return;
      }
      if (mode === 'over') reset();
      if (mode === 'ready') mode = 'playing';
      if (runner.y >= ground - runner.height - 1) runner.velocity = -12.8;
    };

    const spawnStarWave = () => {
      starEnemies = [];
      for (let row = 0; row < 5; row += 1) {
        for (let column = 0; column < 10; column += 1) {
          starEnemies.push({
            x: 45 + column * 63,
            y: 23 + row * 29,
            width: 28,
            height: 20,
            alive: true,
            diving: false,
            diveVx: 0,
            divePhase: row * .7 + column * .3,
          });
        }
      }
    };

    const enterStarMode = () => {
      if (canvas.height !== starHeight) canvas.height = starHeight;
      height = starHeight;
      mode = 'star';
      obstacles = [];
      playerShots = [];
      enemyShots = [];
      starShip.x = width / 2 - starShip.width / 2;
      starShip.y = height - 38;
      starDirection = 1;
      diveIn = 1500;
      starBannerUntil = performance.now() + 1800;
      previous = 0;
      spawnStarWave();
      playBgm(bgm?.dataset.starSrc);
    };

    const fireStarShot = () => {
      if (mode !== 'star' || playerShots.length >= 4) return;
      playerShots.push({ x: starShip.x + starShip.width / 2 - 2, y: starShip.y - 8 });
    };

    const drawFolder = (x: number, y: number, w: number, h: number) => {
      if (!context) return;
      context.fillStyle = '#151515';
      context.fillRect(x - 2, y + 7, w + 4, h - 5);
      context.fillRect(x + 2, y, w * .55, 10);
      context.fillStyle = '#d1a83e';
      context.fillRect(x, y + 9, w, h - 9);
      context.fillStyle = '#efd06b';
      context.fillRect(x + 3, y + 3, w * .5, 7);
      context.fillStyle = '#8d6b20';
      context.fillRect(x + 4, y + h - 6, w - 8, 3);
    };

    const drawPaper = (x: number, y: number, w: number, h: number) => {
      if (!context) return;
      context.fillStyle = '#151515';
      context.fillRect(x - 2, y - 2, w + 4, h + 4);
      context.fillStyle = '#fff';
      context.fillRect(x, y, w, h);
      context.fillStyle = '#1d3f78';
      context.fillRect(x + 5, y + 6, w - 10, 4);
      context.fillStyle = '#777';
      for (let line = 0; line < 3; line += 1) context.fillRect(x + 5, y + 16 + line * 7, w - 10, 2);
    };

    const drawRunner = () => {
      if (!context) return;
      if (runnerImage.complete && runnerImage.naturalWidth) {
        context.save();
        const drawX = runner.x - 12;
        const drawY = runner.y - 7;
        const drawWidth = runner.width + 25;
        const drawHeight = runner.height + 10;
        const runningBob = mode === 'playing' && runner.y >= ground - runner.height - 1 && Math.floor(score / 6) % 2 ? 2 : 0;
        // The source mascot looks left; mirror only the in-game sprite so it
        // faces the direction in which the course is moving.
        context.translate(drawX + drawWidth, runningBob);
        context.scale(-1, 1);
        context.drawImage(runnerImage, 0, drawY, drawWidth, drawHeight);
        context.restore();
      } else {
        context.fillStyle = '#1d3f78';
        context.fillRect(runner.x, runner.y, runner.width, runner.height);
      }
    };

    const drawStarEnemy = (enemy: { x: number; y: number; width: number; height: number; diving?: boolean }, rowColor: string) => {
      if (!context) return;
      context.fillStyle = rowColor;
      context.fillRect(enemy.x + 5, enemy.y, 18, 4);
      context.fillRect(enemy.x, enemy.y + 5, 28, 9);
      context.fillRect(enemy.x + 4, enemy.y + 14, 6, 5);
      context.fillRect(enemy.x + 18, enemy.y + 14, 6, 5);
      context.fillStyle = '#fff';
      context.fillRect(enemy.x + 6, enemy.y + 8, 3, 3);
      context.fillRect(enemy.x + 19, enemy.y + 8, 3, 3);
      if (enemy.diving) {
        context.fillStyle = '#efd06b';
        context.fillRect(enemy.x + 12, enemy.y + 20, 4, 4);
      }
    };

    const drawStarMode = (time: number) => {
      if (!context) return;
      context.fillStyle = '#050816';
      context.fillRect(0, 0, width, height);
      for (let i = 0; i < 48; i += 1) {
        const x = (i * 83 + 17) % width;
        const y = (i * 47 + Math.floor(score * 2)) % height;
        context.fillStyle = i % 5 === 0 ? '#efd06b' : '#fff';
        context.fillRect(x, y, i % 4 === 0 ? 2 : 1, i % 4 === 0 ? 2 : 1);
      }
      const colors = ['#a94d61', '#d1a83e', '#3c8f87'];
      starEnemies.forEach((enemy, index) => {
        if (enemy.alive) drawStarEnemy(enemy, colors[Math.floor(index / 10) % colors.length]);
      });
      context.fillStyle = '#f5f3ea';
      playerShots.forEach((shot) => context.fillRect(shot.x, shot.y, 4, 10));
      context.fillStyle = '#ef6c57';
      enemyShots.forEach((shot) => context.fillRect(shot.x, shot.y, 4, 9));
      context.fillStyle = '#1d3f78';
      context.fillRect(starShip.x + 14, starShip.y, 8, 5);
      context.fillRect(starShip.x + 8, starShip.y + 5, 20, 7);
      context.fillRect(starShip.x + 2, starShip.y + 12, 32, 7);
      context.fillStyle = '#efd06b';
      context.fillRect(starShip.x + 15, starShip.y + 19, 6, 4);
      context.fillStyle = '#fff';
      context.font = 'bold 11px Geneva, sans-serif';
      context.textAlign = 'left';
      context.fillText('← → MOVE   SPACE / CLICK FIRE', 12, height - 10);

      if (time < starBannerUntil || mode === 'star-over') {
        context.fillStyle = 'rgba(5,8,22,.88)';
        context.fillRect(155, 83, 410, 88);
        context.strokeStyle = '#efd06b';
        context.lineWidth = 3;
        context.strokeRect(155, 83, 410, 88);
        context.fillStyle = '#fff';
        context.textAlign = 'center';
        context.font = 'bold 25px Geneva, sans-serif';
        context.fillText(mode === 'star-over' ? words.over : 'AKIRA STAR MODE', width / 2, 119);
        context.font = '13px Geneva, sans-serif';
        context.fillText(mode === 'star-over' ? words.again : '← → MOVE   ·   SPACE / CLICK FIRE', width / 2, 148);
      }
    };

    const draw = (time = 0) => {
      if (!context) return;
      context.imageSmoothingEnabled = false;
      if (mode === 'star' || mode === 'star-over') {
        drawStarMode(time);
        return;
      }
      context.fillStyle = '#f7f6ef';
      context.fillRect(0, 0, width, height);
      context.fillStyle = '#d6d5ce';
      for (let x = 15; x < width; x += 53) context.fillRect(x, 36 + ((x / 53) % 3) * 17, 2, 2);
      context.fillStyle = '#151515';
      context.fillRect(0, ground, width, 3);
      context.fillStyle = '#777';
      for (let x = -(score * 4) % 32; x < width; x += 32) context.fillRect(x, ground + 9, 15, 2);
      obstacles.forEach((obstacle) => {
        const y = ground - obstacle.height;
        if (obstacle.kind === 0) drawFolder(obstacle.x, y, obstacle.width, obstacle.height);
        else drawPaper(obstacle.x, y, obstacle.width, obstacle.height);
      });
      drawRunner();

      if (mode !== 'playing') {
        context.fillStyle = 'rgba(247,246,239,.92)';
        context.fillRect(175, 72, 370, 92);
        context.strokeStyle = '#151515';
        context.lineWidth = 3;
        context.strokeRect(175, 72, 370, 92);
        context.fillStyle = '#151515';
        context.textAlign = 'center';
        context.font = 'bold 22px Geneva, sans-serif';
        context.fillText(mode === 'over' ? words.over : words.ready, width / 2, 110);
        context.font = '14px Geneva, sans-serif';
        context.fillText(mode === 'over' ? words.again : 'SPACE  ·  ↑  ·  CLICK', width / 2, 140);
      }
    };

    const collide = (obstacle: { x: number; width: number; height: number }) => {
      const paddingX = 11;
      const paddingTop = 9;
      return runner.x + runner.width - paddingX > obstacle.x + 3
        && runner.x + paddingX < obstacle.x + obstacle.width - 3
        && runner.y + runner.height - 5 > ground - obstacle.height + 4
        && runner.y + paddingTop < ground;
    };

    const finishGame = (nextMode: 'over' | 'star-over') => {
      mode = nextMode;
      high = Math.max(high, Math.floor(score));
      try { localStorage.setItem('matsui-lab-runner-high', String(high)); } catch (_) {}
      updateScores();
    };

    const updateStarMode = (elapsed: number) => {
      const step = elapsed / 16.67;
      if (leftHeld) starShip.x -= 6.5 * step;
      if (rightHeld) starShip.x += 6.5 * step;
      starShip.x = Math.max(8, Math.min(width - starShip.width - 8, starShip.x));

      let reverse = false;
      starEnemies.forEach((enemy) => {
        if (!enemy.alive) return;
        if (enemy.diving) {
          enemy.divePhase += .09 * step;
          enemy.x += (enemy.diveVx + Math.sin(enemy.divePhase) * 1.45) * step;
          enemy.y += 3.15 * step;
          if (enemy.y > height + 24) {
            enemy.diving = false;
            enemy.x = 55 + Math.random() * (width - 110);
            enemy.y = 18;
          }
        } else {
          enemy.x += starDirection * .68 * step;
          if (enemy.x < 12 || enemy.x + enemy.width > width - 12) reverse = true;
        }
      });
      if (reverse) {
        starDirection *= -1;
        starEnemies.forEach((enemy) => { if (!enemy.diving) enemy.y += 3; });
      }

      playerShots.forEach((shot) => { shot.y -= 9.5 * step; });
      enemyShots.forEach((shot) => { shot.y += 5.4 * step; });
      playerShots = playerShots.filter((shot) => {
        const hit = starEnemies.find((enemy) => enemy.alive
          && shot.x + 4 > enemy.x && shot.x < enemy.x + enemy.width
          && shot.y < enemy.y + enemy.height && shot.y + 10 > enemy.y);
        if (hit) {
          hit.alive = false;
          score += 20;
          return false;
        }
        return shot.y > -12;
      });

      const liveEnemies = starEnemies.filter((enemy) => enemy.alive);
      diveIn -= elapsed;
      const divers = liveEnemies.filter((enemy) => enemy.diving);
      if (diveIn <= 0 && divers.length < 3) {
        const candidates = liveEnemies.filter((enemy) => !enemy.diving);
        const attacker = candidates[Math.floor(Math.random() * candidates.length)];
        if (attacker) {
          attacker.diving = true;
          attacker.diveVx = Math.max(-2.4, Math.min(2.4, (starShip.x - attacker.x) / 75));
          attacker.divePhase = 0;
          enemyShots.push({ x: attacker.x + attacker.width / 2, y: attacker.y + attacker.height });
        }
        diveIn = 850 + Math.random() * 1250;
      }
      if (liveEnemies.length && enemyShots.length < 12 && Math.random() < elapsed / 560) {
        const shooter = liveEnemies[Math.floor(Math.random() * liveEnemies.length)];
        enemyShots.push({ x: shooter.x + shooter.width / 2, y: shooter.y + shooter.height });
      }
      enemyShots = enemyShots.filter((shot) => shot.y < height + 12);
      const shipHit = enemyShots.some((shot) => shot.x + 4 > starShip.x && shot.x < starShip.x + starShip.width
        && shot.y + 9 > starShip.y && shot.y < starShip.y + starShip.height);
      const rammed = liveEnemies.some((enemy) => enemy.diving
        && enemy.x + enemy.width > starShip.x && enemy.x < starShip.x + starShip.width
        && enemy.y + enemy.height > starShip.y && enemy.y < starShip.y + starShip.height);
      const invaded = liveEnemies.some((enemy) => !enemy.diving && enemy.y + enemy.height >= starShip.y);
      if (shipHit || rammed || invaded) finishGame('star-over');
      else if (!liveEnemies.length) {
        score += 100;
        enemyShots = [];
        spawnStarWave();
      }
      updateScores();
    };

    const loop = (time: number) => {
      if (!dialog.open) return;
      const elapsed = previous ? Math.min(34, time - previous) : 16.67;
      previous = time;
      if (mode === 'star') {
        updateStarMode(elapsed);
      } else if (mode === 'playing') {
        const step = elapsed / 16.67;
        const speed = Math.min(11, 5.5 + score / 260);
        runner.velocity += .72 * step;
        runner.y = Math.min(ground - runner.height, runner.y + runner.velocity * step);
        spawnIn -= elapsed;
        if (spawnIn <= 0) {
          const kind = Math.random() > .52 ? 1 : 0;
          obstacles.push({ x: width + 20, width: kind ? 31 : 42, height: kind ? 47 : 35, kind });
          spawnIn = nextSpawnDelay();
        }
        obstacles.forEach((obstacle) => { obstacle.x -= speed * step; });
        obstacles = obstacles.filter((obstacle) => obstacle.x + obstacle.width > -10);
        score += elapsed / 92;
        if (score >= secretScore) enterStarMode();
        else if (obstacles.some(collide)) finishGame('over');
        updateScores();
      }
      draw(time);
      frame = requestAnimationFrame(loop);
    };

    const openGame = () => {
      reset();
      dialog.showModal();
      playBgm(bgm?.dataset.runnerSrc);
      canvas.focus();
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(loop);
    };
    const closeGame = () => {
      cancelAnimationFrame(frame);
      bgm?.pause();
      dialog.close();
      openButton.focus();
    };

    openButton.addEventListener('click', openGame);
    closeButtons.forEach((button) => button.addEventListener('click', closeGame));
    retryButton?.addEventListener('click', () => { reset(); playBgm(bgm?.dataset.runnerSrc); startOrJump(); canvas.focus(); });
    muteButton?.addEventListener('click', () => {
      musicMuted = !musicMuted;
      try { localStorage.setItem('matsui-lab-runner-music-muted', String(musicMuted)); } catch (_) {}
      updateMusicButton();
      if (!musicMuted && bgm?.paused) bgm.play().catch(() => {});
      canvas.focus();
    });
    canvas.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      if (mode === 'star') {
        const rect = canvas.getBoundingClientRect();
        starShip.x = (event.clientX - rect.left) * (width / rect.width) - starShip.width / 2;
      }
      startOrJump();
    });
    dialog.addEventListener('cancel', (event) => { event.preventDefault(); closeGame(); });
    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;
      if (event.key.length === 1 && /^[a-z]$/i.test(event.key)) {
        commandBuffer = `${commandBuffer}${event.key.toLowerCase()}`.slice(-5);
        if (commandBuffer === 'akira' && mode !== 'star') enterStarMode();
      }
      if (mode === 'star') {
        if (event.code === 'ArrowLeft') leftHeld = true;
        if (event.code === 'ArrowRight') rightHeld = true;
        if (['Space', 'ArrowLeft', 'ArrowRight'].includes(event.code)) event.preventDefault();
        if (event.code === 'Space' && !event.repeat) fireStarShot();
        return;
      }
      if (mode === 'star-over' && event.code === 'Space') {
        event.preventDefault();
        enterStarMode();
        return;
      }
      if (['Space', 'ArrowUp'].includes(event.code)) {
        event.preventDefault();
        startOrJump();
      }
    });
    document.addEventListener('keyup', (event) => {
      if (event.code === 'ArrowLeft') leftHeld = false;
      if (event.code === 'ArrowRight') rightHeld = false;
    });
    runnerImage.addEventListener('load', draw);
    updateScores();
    updateMusicButton();
    draw();
  }
</script>


---
import type { Locale } from '../data/site';
import { site } from '../data/site';
import { u } from '../lib/url';
import LabRunner from './LabRunner.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const cta = locale === 'ja'
  ? { research: '研究フォルダを開く…', members: 'メンバーを見る…' }
  : { research: 'Open Research Folder…', members: 'View People…' };
const researchHref = u(locale === 'ja' ? '/ja/research/' : '/research/');
const membersHref = u(locale === 'ja' ? '/ja/members/' : '/members/');
const characterSrc = u('/charactor-pixel.png');
---

<section class="mac-hero">
  <div class="hero-copy">
    <p class="mac-kicker">{locale === 'ja' ? '松井研究室ディスク' : 'Matsui Lab Disk'}</p>
    <h1>{site.labName[locale]}</h1>
    <p class="hero-welcome">{locale === 'ja' ? 'ようこそ、松井研究室へ。' : 'Welcome to Matsui Lab.'}</p>
    <p class="hero-tagline">{site.tagline[locale]}</p>
    <p class="hero-sub">{locale === 'ja' ? 'このディスクには、計算社会科学とウェブ情報学に関する研究情報が収録されています。' : 'This disk contains research information on computational social science and web information studies.'}</p>
    <div class="mac-keywords">
      {site.keywords[locale].map((keyword) => <span>{keyword}</span>)}
    </div>
    <div class="mac-actions">
      <a href={researchHref} class="default-button">{cta.research}</a>
      <a href={membersHref} class="mac-button">{cta.members}</a>
    </div>
  </div>
  <aside class="about-this-mac">
    <LabRunner locale={locale} characterSrc={characterSrc} />
    <strong>{locale === 'ja' ? 'このサイトについて' : 'About This Website'}</strong>
    <p>{locale === 'ja' ? 'このホームページでは、松井研究室の研究テーマ、論文・講演、メンバー情報、研究室への参加案内をご覧いただけます。上のメニューまたはフォルダからお進みください。' : 'This website presents Matsui Lab research themes, publications, talks, member information, and details for prospective students and collaborators. Use the menu or folders to explore.'}</p>
    <small>{site.affiliation[locale]}</small>
  </aside>
</section>

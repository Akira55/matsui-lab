---
import type { Locale } from '../data/site';
import { getFeed, type FeedTag } from '../data/feed';

interface Props {
  locale: Locale;
  limit?: number;
}
const { locale, limit } = Astro.props;
const all = getFeed(locale);
const items = limit ? all.slice(0, limit) : all;

const tagStyle: Record<FeedTag, { label: Record<Locale, string> }> = {
  paper: { label: { en: 'PAPER', ja: '論文' } },
  talk: { label: { en: 'TALK', ja: '講演' } },
  misc: { label: { en: 'MISC', ja: 'その他' } },
  award: { label: { en: 'AWARD', ja: '受賞' } },
  grant: { label: { en: 'GRANT', ja: '助成' } },
  book: { label: { en: 'BOOK', ja: '書籍' } },
  service: { label: { en: 'SERVICE', ja: '学術貢献' } },
  media: { label: { en: 'MEDIA', ja: 'メディア' } },
  lab: { label: { en: 'LAB', ja: '研究室' } },
};
---

<ul class="grid gap-4">
  {items.map((item) => {
    const t = tagStyle[item.tag];
    return (
      <li class="sticker-sm flex flex-col gap-2 p-4 transition-transform hover:-translate-y-0.5 sm:flex-row sm:items-start sm:gap-4">
        <div class="flex shrink-0 items-center gap-2 sm:w-44">
          <time class="font-display text-sm tabular-nums text-pop-ink/70" datetime={item.date}>
            {item.date}
          </time>
          <span class:list={['feed-tag', `feed-tag-${item.tag}`]}>
            {t.label[locale]}
          </span>
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-display text-base leading-snug text-pop-ink">
            {item.url ? (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:underline decoration-pop-yellow decoration-2 underline-offset-4"
              >
                {item.title}
                <span class="text-pop-blue" aria-hidden="true">↗</span>
              </a>
            ) : (
              item.title
            )}
          </p>
          {item.meta && <p class="mt-1 text-sm italic text-pop-ink/70">{item.meta}</p>}
          {item.body && <p class="mt-1 text-sm text-pop-ink/80">{item.body}</p>}
        </div>
      </li>
    );
  })}
</ul>

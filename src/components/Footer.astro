---
import type { Locale } from '../data/site';
import { site } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mac-statusbar">
  <span>{locale === 'ja' ? '松井研究室ディスクは使用できます' : 'Matsui Lab Disk is ready'}</span>
  <nav aria-label="External links">
    <a href={site.socials.researchmap}>researchmap</a>
    <a href={site.socials.kobe}>Kobe U</a>
    <a href={site.contactForm}>{locale === 'ja' ? 'お問い合わせ…' : 'Contact…'}</a>
  </nav>
  <span class="resize-handle" aria-hidden="true">◢</span>
</footer>

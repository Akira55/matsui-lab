---
import type { Locale } from '../data/site';
import { talks } from '../data/talks';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const grouped = talks.reduce<Record<number, typeof talks>>((acc, t) => {
  const y = Number(t.date.slice(0, 4));
  (acc[y] ||= []).push(t);
  return acc;
}, {});
const years = Object.keys(grouped)
  .map(Number)
  .sort((a, b) => b - a);

const typeChip: Record<string, { label: Record<Locale, string> }> = {
  invited: { label: { en: 'invited', ja: '招待' } },
  oral: { label: { en: 'oral', ja: '口頭' } },
  poster: { label: { en: 'poster', ja: 'ポスター' } },
  keynote: { label: { en: 'keynote', ja: '基調' } },
};
---

<div class="space-y-10">
  {years.map((year) => (
    <section>
      <div class="flex items-baseline gap-3">
        <h3 class="font-display text-3xl text-pop-ink">{year}</h3>
        <span class="h-[3px] flex-1 bg-pop-ink"></span>
      </div>
      <ol class="mt-5 space-y-3">
        {grouped[year].map((t) => {
          const chip = typeChip[t.type];
          return (
            <li class="sticker-sm p-4 transition-transform hover:-translate-y-0.5">
              <div class="flex flex-wrap items-center gap-3">
                <time class="font-display text-sm tabular-nums text-pop-ink/70" datetime={t.date}>{t.date}</time>
                {chip && (
                  <span class:list={['talk-tag', `talk-tag-${t.type}`]}>
                    {chip.label[locale]}
                  </span>
                )}
              </div>
              <p class="mt-2 font-display text-base leading-snug text-pop-ink">
                {t.url ? (
                  <a
                    href={t.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="decoration-pop-yellow decoration-2 underline-offset-4 hover:underline hover:text-pop-blue"
                  >
                    {t.title}
                    <span aria-hidden="true" class="ml-1 text-pop-blue">↗</span>
                  </a>
                ) : (
                  t.title
                )}
              </p>
              {t.venue && <p class="mt-1 text-sm italic text-pop-ink/70">{t.venue}</p>}
            </li>
          );
        })}
      </ol>
    </section>
  ))}
</div>

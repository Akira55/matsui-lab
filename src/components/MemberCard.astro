---
import type { Locale } from '../data/site';
import type { Member } from '../data/members';

interface Props {
  member: Member;
  locale: Locale;
}
const { member, locale } = Astro.props;
---

<article class="sticker relative p-6 transition-transform hover:-translate-y-1 hover:rotate-[-0.6deg]">
  <span aria-hidden="true" class="member-corner-icon">
    ◆
  </span>
  <div class="flex items-start gap-4">
    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border-[3px] border-pop-ink bg-pop-blue-soft font-display text-2xl text-pop-ink shadow-sticker-sm">
      {member.name[locale]?.[0] ?? '·'}
    </div>
    <div class="min-w-0 flex-1">
      <h3 class="font-display text-2xl leading-tight text-pop-ink">{member.name[locale]}</h3>
      <p class="mt-1 font-display text-sm text-pop-blue">{member.role[locale]}</p>
      {member.affiliation && (
        <p class="mt-1 text-sm text-pop-ink/70">{member.affiliation[locale]}</p>
      )}
      {member.bio && <p class="mt-3 text-sm leading-relaxed text-pop-ink/80">{member.bio[locale]}</p>}
      {member.links && (
        <div class="mt-3 flex flex-wrap gap-2">
          {member.links.map((l) => (
            <a class="chip bg-pop-yellow-soft hover:bg-pop-yellow" href={l.href}>{l.label} ↗</a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>

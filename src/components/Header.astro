---
import type { Locale } from '../data/site';
import { site } from '../data/site';
import { nav, ui } from '../data/i18n';
import { u } from '../lib/url';

interface Props { locale: Locale; current?: string; }
const { locale } = Astro.props;
const localePrefix = locale === 'ja' ? '/ja' : '';
const otherLocalePrefix = locale === 'ja' ? '' : '/ja';
const homeHref = u(`${localePrefix}/`);
const otherHref = u(`${otherLocalePrefix}/`);
const modernHref = u(`/modern${localePrefix}/`);
const items = [
  { key: 'research', href: u(`${localePrefix}/research/`) },
  { key: 'members', href: u(`${localePrefix}/members/`) },
  { key: 'publications', href: u(`${localePrefix}/publications/`) },
  { key: 'talks', href: u(`${localePrefix}/talks/`) },
  { key: 'news', href: u(`${localePrefix}/news/`) },
  { key: 'join', href: u(`${localePrefix}/join/`) },
  { key: 'contact', href: u(`${localePrefix}/contact/`) },
];
---

<header class="system-menubar">
  <a href={homeHref} class="system-mark" aria-label={site.labName[locale]}>◆</a>
  <details class="site-menu">
    <summary>{locale === 'ja' ? 'ファイル' : 'File'}</summary>
    <div class="menu-dropdown">
      <a href={homeHref}>{locale === 'ja' ? 'ホームフォルダを開く' : 'Open Home Folder'}</a>
      <span class="menu-rule"></span>
      {items.map((item) => <a href={item.href}>{nav[locale][item.key]}</a>)}
    </div>
  </details>
  <details class="site-menu desktop-menu">
    <summary>{locale === 'ja' ? '編集' : 'Edit'}</summary>
    <div class="menu-dropdown menu-dropdown-narrow">
      <span class="menu-disabled">{locale === 'ja' ? '取り消し' : 'Undo'}<kbd>⌘Z</kbd></span>
      <span class="menu-rule"></span>
      <span class="menu-disabled">{locale === 'ja' ? 'すべてを選択' : 'Select All'}<kbd>⌘A</kbd></span>
    </div>
  </details>
  <details class="site-menu desktop-menu">
    <summary>{locale === 'ja' ? '表示' : 'View'}</summary>
    <div class="menu-dropdown menu-dropdown-narrow">
      <a href={homeHref}><span class="menu-check">✓</span>{locale === 'ja' ? 'アイコン表示' : 'by Icon'}</a>
      <a href={u(`${localePrefix}/news/`)}><span class="menu-check"></span>{locale === 'ja' ? '新しい順に表示' : 'by Date'}</a>
    </div>
  </details>
  <details class="site-menu">
    <summary>{locale === 'ja' ? '移動' : 'Go'}</summary>
    <div class="menu-dropdown">
      {items.slice(0, 5).map((item) => <a href={item.href}>{nav[locale][item.key]}</a>)}
    </div>
  </details>
  <details class="site-menu desktop-menu">
    <summary>{locale === 'ja' ? '特別' : 'Special'}</summary>
    <div class="menu-dropdown">
      <a href={homeHref}>{locale === 'ja' ? 'この松井研究室について…' : 'About Matsui Lab…'}</a>
      <span class="menu-rule"></span>
      <a href={site.socials.cv} target="_blank" rel="noopener noreferrer">Akira's CV</a>
      <a href="https://kidpix.app/ja.html" target="_blank" rel="noopener noreferrer">{locale === 'ja' ? 'キッドピクスを開く' : 'Open Kid Pix'}</a>
      <span class="menu-rule"></span>
      <a href={modernHref}>{locale === 'ja' ? 'モダン版へ切り替え' : 'Switch to Modern Site'}</a>
      <span class="menu-rule"></span>
      {items.slice(5).map((item) => <a href={item.href}>{nav[locale][item.key]}</a>)}
    </div>
  </details>
  <span class="menubar-spacer"></span>
  <a href={modernHref} class="version-switch">{locale === 'ja' ? 'モダン版' : 'Modern'}</a>
  <a href={otherHref} class="language-switch">{ui[locale].languageLabel}</a>
  <span class="menubar-clock" data-mac-clock>--:--</span>
</header>

<script is:inline>
  const clock = document.querySelector('[data-mac-clock]');
  const tick = () => {
    if (clock) clock.textContent = new Intl.DateTimeFormat(document.documentElement.lang, { hour: '2-digit', minute: '2-digit' }).format(new Date());
  };
  tick();
  window.setInterval(tick, 30000);
  document.addEventListener('click', (event) => {
    document.querySelectorAll('.site-menu[open]').forEach((menu) => {
      if (!menu.contains(event.target)) menu.removeAttribute('open');
    });
  });
</script>

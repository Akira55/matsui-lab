---
import { publications } from '../data/publications';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const items = limit ? publications.slice(0, limit) : publications;

const grouped = items.reduce<Record<number, typeof items>>((acc, p) => {
  (acc[p.year] ||= []).push(p);
  return acc;
}, {});
const years = Object.keys(grouped)
  .map(Number)
  .sort((a, b) => b - a);

---

<div class="space-y-10">
  {years.map((year) => (
    <section>
      <div class="flex items-baseline gap-3">
        <h3 class="font-display text-3xl text-pop-ink">{year}</h3>
        <span class="h-[3px] flex-1 bg-pop-ink"></span>
      </div>
      <ol class="mt-5 space-y-3">
        {grouped[year].map((p) => (
          <li class="sticker-sm p-4 transition-transform hover:-translate-y-0.5">
            <div class="flex flex-wrap items-center gap-2">
              {p.type && (
                <span class:list={['publication-tag', `publication-tag-${p.type}`]}>{p.type}</span>
              )}
              {p.highlight && (
                <span class="highlight-tag">
                  ★ highlight
                </span>
              )}
              {p.authors && <span class="text-xs text-pop-ink/60">{p.authors}</span>}
            </div>
            <p class="mt-2 font-display text-base leading-snug text-pop-ink">
              {p.url ? (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="decoration-pop-yellow decoration-2 underline-offset-4 hover:underline hover:text-pop-blue"
                >
                  {p.title}
                  <span aria-hidden="true" class="ml-1 text-pop-blue">↗</span>
                </a>
              ) : (
                p.title
              )}
            </p>
            {p.venue && <p class="mt-1 text-sm italic text-pop-ink/70">{p.venue}</p>}
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>
